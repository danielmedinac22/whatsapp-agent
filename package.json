{
  "name": "whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp dashboard with Baileys + Shopify follow-up + OpenRouter agent",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "dev:web": "pnpm --filter @wa/web dev",
    "dev:worker": "pnpm --filter @wa/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @wa/db generate",
    "db:push": "pnpm --filter @wa/db push",
    "db:migrate": "pnpm --filter @wa/db migrate",
    "db:seed": "pnpm --filter @wa/db seed",
    "db:studio": "pnpm --filter @wa/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.4",
    "globals": "^16.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0"
  }
}
