# ============================================
# Postgres (Railway)
# ============================================
DATABASE_URL=postgresql://user:pass@host:5432/whatsapp_agent

# ============================================
# Web app (Next.js / Vercel)
# ============================================
AUTH_SECRET=change-me-32-bytes-base64
WORKER_URL=http://localhost:3001
NEXT_PUBLIC_WORKER_URL=http://localhost:3001
WORKER_API_TOKEN=change-me-shared-with-worker

# ============================================
# Worker (Railway)
# ============================================
PORT=3001
WEB_ORIGIN=http://localhost:3000
OPENROUTER_API_KEY=sk-or-v1-...
SHOPIFY_WEBHOOK_SECRET=shpss_...
LOG_LEVEL=info

# ============================================
# Kapso (WhatsApp Cloud API)
# ============================================
# API key: Kapso dashboard → project → API keys
KAPSO_API_KEY=kapso_...
KAPSO_API_BASE_URL=https://api.kapso.ai
# Secret propio (32+ bytes aleatorios) usado como secret_key del webhook
KAPSO_WEBHOOK_SECRET=change-me-random-32-bytes
# URL pública del worker (Railway) para registrar el webhook /kapso/webhook
PUBLIC_URL=https://whatsapp-worker.up.railway.app
